{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2ReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeImages",
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumesModifications",
        "ec2:DescribeSnapshots",
        "ec2:DescribeTags",
        "ec2:DescribeAddresses",
        "ec2:DescribeReplaceRootVolumeTasks",
        "ec2:DescribeIamInstanceProfileAssociations",
        "autoscaling:DescribeAutoScalingInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2InstanceStateChanges",
      "Effect": "Allow",
      "Action": [
        "ec2:StopInstances",
        "ec2:StartInstances",
        "ec2:RebootInstances",
        "ec2:CreateReplaceRootVolumeTask"
      ],
      "Resource": "arn:aws:ec2:*:YOUR_ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/WindowsUpgrade": "true"
        }
      }
    },
    {
      "Sid": "EC2VolumeAndImageActions",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:ModifyVolume",
        "ec2:CreateImage",
        "ec2:EnableImageDeprecation"
      ],
      "Resource": [
        "arn:aws:ec2:*:YOUR_ACCOUNT_ID:volume/*",
        "arn:aws:ec2:*:YOUR_ACCOUNT_ID:instance/*",
        "arn:aws:ec2:*:YOUR_ACCOUNT_ID:image/*",
        "arn:aws:ec2:*:YOUR_ACCOUNT_ID:snapshot/*"
      ]
    },
    {
      "Sid": "EC2CreateTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "arn:aws:ec2:*:YOUR_ACCOUNT_ID:*"
    },
    {
      "Sid": "SSMReadOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:DescribeInstanceInformation",
        "ssm:GetDocument",
        "ssm:ListCommands",
        "ssm:ListCommandInvocations",
        "ssm:GetAutomationExecution",
        "ssm:DescribeAutomationExecutions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SSMSendCommand",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ec2:*:YOUR_ACCOUNT_ID:instance/*",
        "arn:aws:ssm:*:YOUR_ACCOUNT_ID:document/*",
        "arn:aws:ssm:*::document/AWS-*"
      ]
    },
    {
      "Sid": "SSMStartAutomation",
      "Effect": "Allow",
      "Action": [
        "ssm:StartAutomationExecution"
      ],
      "Resource": [
        "arn:aws:ssm:*:YOUR_ACCOUNT_ID:automation-definition/*",
        "arn:aws:ssm:*::automation-definition/AWS-*"
      ]
    },
    {
      "Sid": "IAMReadOnly",
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile",
        "iam:ListInstanceProfiles",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2InstanceProfileAssociation",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateIamInstanceProfile",
        "ec2:DisassociateIamInstanceProfile"
      ],
      "Resource": "arn:aws:ec2:*:YOUR_ACCOUNT_ID:instance/*"
    },
    {
      "Sid": "PassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::YOUR_ACCOUNT_ID:role/WindowsUpgradeInstanceRole",
        "arn:aws:iam::YOUR_ACCOUNT_ID:role/WindowsUpgradeAutomationRole"
      ]
    },
    {
      "Sid": "SNSNotification",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:*:YOUR_ACCOUNT_ID:*"
    }
  ]
}
